DGII_TEST_TOKEN=replace-with-a-long-random-token
DGII_CERT_P12_BASE64=replace-with-the-p12-base64
DGII_CERT_PASSWORD=replace-with-the-p12-password
DATABASE_URL=postgresql://user:password@private-host/database?sslmode=require
DGII_STORAGE_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-in-base64
DGII_RECEIVER_RNC=replace-with-your-9-or-11-digit-rnc
# Permanece false/ausente ate a autorizacao e os dados testecf serem confirmados.
DGII_ENABLE_TEST_SUBMISSION=false
